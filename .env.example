# Copy this file to `.env` and fill in your own keys.
# `.env` is git-ignored and must NEVER be committed.
#
#   cp .env.example .env
#   # edit .env, then:
#   bash run.sh

# --- required ---
# E2B sandbox API key (https://e2b.dev/)
export E2B_API_KEY=""
# DashScope key used by the agent inside the sandbox
export DASHSCOPE_API_KEY=""
# OSS credentials for pulling the compressed task assets into the sandbox
export OSS_ACCESS_KEY_ID=""
export OSS_ACCESS_KEY_SECRET=""

# --- optional: training backend ---
# Tinker cloud (0-GPU path):
#   export TINKER_BASE_URL="https://api.tinker.thinkingmachines.ai"
#   export TINKER_API_KEY="<your tinker key>"
# Self-hosted TuFT (default): leave unset; run.sh derives http://<vpc-ip>:10610

# --- optional: overrides ---
# export TOTAL_STEPS=19
# export RUNNER_PER_MODEL=64
# export E2B_DOMAIN="sandbox01.vpc.cn-hongkong.pai-eas.aliyuncs.com"
# export E2B_TEMPLATE="agentscope-qwenpaw-0518"
